HUSTUDY_ENV=production
HUSTUDY_WORKER_AUTOSTART=false
HUSTUDY_DATABASE_URL=sqlite:////var/lib/hustudy/hustudy.db
HUSTUDY_STORAGE_ROOT=/var/lib/hustudy/storage
HUSTUDY_STORAGE_RESERVE_BYTES=67108864
# Required: generate your own random secret (at least 32 characters) before starting.
HUSTUDY_JWT_SECRET=
HUSTUDY_CORS_ORIGINS=https://study.example.com
HUSTUDY_LLM_PROVIDER=mock
HUSTUDY_ZHIPU_API_KEY=
# Optional: absolute path to the installed LibreOffice executable.
HUSTUDY_LIBREOFFICE_PATH=
