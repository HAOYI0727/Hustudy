[Unit]
Description=Hustudy API
Requires=hustudy-migrate.service
Wants=hustudy-worker.service
After=network.target hustudy-migrate.service

[Service]
Type=simple
User=hustudy
Group=hustudy
WorkingDirectory=/opt/hustudy
EnvironmentFile=/etc/hustudy/hustudy.env
Environment=PYTHONPATH=/opt/hustudy/backend
ExecStart=/opt/hustudy/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
