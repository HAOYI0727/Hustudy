HUSTUDY_ENV=development
HUSTUDY_DATABASE_URL=sqlite:///./data/hustudy.db
HUSTUDY_STORAGE_ROOT=./data/storage
HUSTUDY_STORAGE_RESERVE_BYTES=67108864
# Optional absolute path; otherwise discover LibreOffice from PATH/macOS Applications.
HUSTUDY_LIBREOFFICE_PATH=
# setup.sh initializes a random local secret; do not commit an actual value.
HUSTUDY_JWT_SECRET=
HUSTUDY_ACCESS_TOKEN_MINUTES=120
HUSTUDY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HUSTUDY_LLM_PROVIDER=mock
HUSTUDY_LLM_MODEL=glm-4.7-flash
HUSTUDY_LLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
HUSTUDY_ZHIPU_API_KEY=
